{| class="wikitable" style="float: right; margin-left: 1.5em; width: 320px; border: 1px solid #16a085;"
|+ style="background-color: #16a085; color: #ffffff; font-weight: bold; padding: 8px;" | {{{DeviceModel|{{PAGENAME}}}}}
|-
! scope="row" style="background-color: rgba(22, 160, 133, 0.1);" | Vendor
| {{{Vendor|Unknown}}}
|-
! scope="row" style="background-color: rgba(22, 160, 133, 0.1);" | Type
| {{{DeviceType|Laptop}}}
