# ==============================================================================
# Parch Linux MediaWiki Environment Configuration
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Site Configuration
MW_SITENAME=Parch Linux Wiki
MW_SERVER=http://localhost
MW_HTTP_PORT=80
MW_HTTPS_PORT=443
MW_LANG=en
MW_EMERGENCY_CONTACT=admin@parchlinux.com
MW_PASSWORD_SENDER=wiki@parchlinux.com

# Database Settings (MariaDB)
MW_DB_SERVER=db
MW_DB_PORT=3306
MW_DB_NAME=parchwiki
MW_DB_USER=wikiuser
MW_DB_PASSWORD=wikipassword_change_me
MW_DB_ROOT_PASSWORD=mariadb_root_change_me
MW_DB_PREFIX=

# Cache Settings (Redis)
MW_REDIS_SERVER=cache:6379
MW_REDIS_PASSWORD=

# Security & Secrets
MW_SECRET_KEY=change_this_to_a_random_64_character_hex_string_for_production
MW_UPGRADE_KEY=change_this_to_a_random_32_character_hex_string

# Cloudflare Turnstile / Anti-Spam Captcha (Optional)
MW_TURNSTILE_SITE_KEY=
MW_TURNSTILE_SECRET_KEY=
